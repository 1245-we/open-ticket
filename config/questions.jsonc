[
  {
    "id": "support-area",
    "name": "Área de soporte",
    "description": "Seleccioná el área en la que necesitás ayuda.",
    "type": "radio-select",
    "required": true,
    "choices": [
      {"title": "Problema técnico", "description": "Errores, bugs o problemas de conexión.", "selectedByDefault": false},
      {"title": "Jugabilidad", "description": "Dudas, mecánicas o situaciones dentro del servidor.", "selectedByDefault": false},
      {"title": "Usuario o jugador", "description": "Consultas relacionadas con otros jugadores.", "selectedByDefault": false},
      {"title": "Otro", "description": "Una consulta que no encaja en las opciones anteriores.", "selectedByDefault": false}
    ]
  },
  {
    "id": "support-priority",
    "name": "Prioridad",
    "description": "Indicá qué tan urgente es tu consulta.",
    "type": "radio-select",
    "required": true,
    "choices": [
      {"title": "Baja", "description": "Consulta general sin urgencia.", "selectedByDefault": false},
      {"title": "Media", "description": "Necesito asistencia próximamente.", "selectedByDefault": false},
      {"title": "Alta", "description": "El problema afecta considerablemente mi experiencia.", "selectedByDefault": false}
    ]
  },
  {
    "id": "support-subject",
    "name": "Asunto",
    "description": "Resumí brevemente el motivo de tu ticket.",
    "type": "short",
    "required": true,
    "placeholder": "¿En qué necesitás ayuda?",
    "length": {"enabled": true, "min": 3, "max": 100}
  },
  {
    "id": "support-details",
    "name": "Descripción del problema",
    "description": "Explicá detalladamente tu situación.",
    "type": "paragraph",
    "required": true,
    "placeholder": "Describí qué ocurrió, cuándo y qué intentaste hacer...",
    "length": {"enabled": true, "min": 10, "max": 1000}
  },
  {
    "id": "support-evidence",
    "name": "Evidencia",
    "description": "Si tenés capturas, videos o enlaces, compartilos.",
    "type": "paragraph",
    "required": false,
    "placeholder": "Enlaces o información adicional...",
    "length": {"enabled": false, "min": 0, "max": 1000}
  },
  {
