
[
  {
    "id": "soporte-general",
    "name": "Soporte general",
    "description": "¿Necesitas ayuda? Nuestro equipo de asistencia está aquí para ayudarte.",
    "type": "ticket",
    "button": {
      "emoji": "🎫",
      "label": "Soporte",
      "color": "gray"
