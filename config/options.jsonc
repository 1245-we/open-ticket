    "ticketMessage": {
      "enabled": true,
      "text": "",
      "embed": {
        "enabled": true,
        "title": "✦ SOPORTE GENERAL",
        "description": "Bienvenido al centro de soporte de MystiCa.\n\nTu solicitud ha sido registrada correctamente. Un integrante del equipo revisará tu caso y te atenderá lo antes posible.\n\n**Mientras esperás:**\n• Evitá enviar mensajes repetidos.\n• Proporcioná toda la información necesaria.\n• Mantené un trato respetuoso.",
        "customColor": "#D4AF37",
        "image": "",
        "thumbnail": "",
        "fields": [],
        "timestamp": true
      },
      "ping": {
        "@here": false,
        "@everyone": false,
        "custom": []
      }
    },
    "autoclose": {
      "enableInactiveHours": false,
      "inactiveHours": 24,
      "enableUserLeave": false,
      "disableOnClaim": false
    },
    "autodelete": {
      "enableInactiveDays": false,
      "inactiveDays": 7,
      "enableUserLeave": false,
      "disableOnClaim": false
    },
